# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment — Vercel project `medcamp-prod` (branch: main)
# Canonical host: https://events.dcica.org
#
# INTERIM TOPOLOGY (pending the Azure migration, docs/superpowers/specs/
# 2026-08-17-azure-migration-design.md): prod does NOT get its own Supabase
# project. It shares the single free project with test/staging and is isolated
# only by the Postgres schema `prod`. Consequences, accepted knowingly:
#   - prod shares compute, connection budget and SUPABASE_SERVICE_ROLE_KEY with test
#   - the service-role key bypasses RLS and can reach every schema
#   - NEVER run `prisma migrate reset` against this project
#   - `&schema=prod` / `?schema=prod` is MANDATORY. A schema-less URL silently
#     writes into `public`, which already holds a stray copy from an earlier slip.
#
# Enter these in the Vercel project (Production scope of medcamp-prod, UNPINNED —
# a branch-pinned var is Preview-only and never reaches Production) and in the
# GitHub Environment `production` (DATABASE_URL + DIRECT_URL; add a required
# reviewer there). TEMPLATE only — never commit real secrets. docs/Deployment.md.
#
# Posture: REAL tenant data, test-login OFF, Stripe live-mode when activated.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_APP_URL=https://events.dcica.org
NEXT_PUBLIC_ROOT_DOMAIN=events.dcica.org
TENANT_ROUTING=path
DEFAULT_ORG_SLUG=dcica
BOOTSTRAP_ADMIN_EMAILS=<real-coordinator-emails-comma-separated>
LOG_LEVEL=info

# ── Database (shared Supabase project, schema `prod`) ──
DATABASE_URL=postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=prod
DIRECT_URL=postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:5432/postgres?schema=prod
# Realtime is not wired by design (dashboard + station views poll — see
# AutoRefresh.tsx), so the NEXT_PUBLIC_SUPABASE_* keys are optional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (NextAuth + Google OIDC) ──
# Test-login is OFF in prod, so Google is the ONLY way in. The redirect URI
# https://events.dcica.org/api/auth/callback/google MUST be registered in Google
# Cloud Console or production is unadministrable.
NEXTAUTH_SECRET=<unique-random-string>
NEXTAUTH_URL=https://events.dcica.org
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# ── Payments (Stripe) ──
# Launch with TEST-mode keys until the DCICA account is activated for live
# payments; all seeded events stay DRAFT until the live flip. Then swap to
# pk_live/sk_live, recreate the webhook endpoint in live mode, replace the
# signing secret, and only then set events to OPEN.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint at https://events.dcica.org/api/stripe/webhook
# (event: checkout.session.completed). Without a live endpoint, a buyer who
# closes the tab after paying leaves the order PENDING forever.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Address validation (optional; use a restricted key in prod) ──
GOOGLE_MAPS_API_KEY=

# ── Test-only login — MUST be OFF in production ──
# Leave both UNSET. Do not set TEST_LOGIN_ENABLED=true on a real tenant — it is
# an auth back door. (Listed here only to document that it must stay off.)
# TEST_LOGIN_ENABLED=
# TEST_LOGIN_PASSWORD=

# ── Email (AWS SES — production access granted, dcica.org DKIM-verified) ──
# Credentials MUST be passed explicitly; the AWS SDK's default credential chain
# fails inside bundled Next.js serverless functions (see src/lib/email.ts).
EMAIL_PROVIDER=ses
EMAIL_FROM="dcica <no-reply@dcica.org>"
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<ses-iam-access-key>
AWS_SECRET_ACCESS_KEY=<ses-iam-secret-key>
